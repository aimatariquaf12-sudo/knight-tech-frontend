me\":\"relative flex h-(--navbar-height) w-full items-center gap-5 border-white/10 border-b\",\"children\":[[\"$\",\"$L30\",null,{\"href\":\"/all\",\"children\":[\"$\",\"svg\",null,{\"xmlns\":\"http://www.w3.org/2000/svg\",\"viewBox\":\"0 0 58 18\",\"className\":\"size-5 shrink-0 w-14.5\",\"role\":\"$undefined\",\"aria-hidden\":true,\"children\":[null,[\"$\",\"use\",null,{\"href\":\"/icons.svg?v=f5ed3491#logo\"}]]}]}],[\"$\",\"$L31\",null,{\"isSuperCollaborator\":false}],[\"$\",\"ul\",null,{\"className\":\"ml-auto flex h-full items-stretch gap-2 text-m-mobile text-white lg:text-m\",\"children\":[[\"$\",\"$L32\",null,{}],[\"$\",\"$L33\",null,{\"profile\":{\"userId\":\"9bd68d86-8ade-4be9-acad-c7aefe509095\",\"full_name\":\"AIMA TARIQ\",\"updated_at\":\"2026-06-24T04:54:58.499644+00:00\",\"avatarUrl\":\"$undefined\",\"isTosAccepted\":false,\"isBanned\":false},\"isSuperCollaborator\":false,\"changelogs\":[{\"id\":3,\"title\":\"Pika Turbo is here 🏎️💨\",\"description\":[{\"type\":\"paragraph\",\"children\":[{\"bold\":true,\"text\":\"Make more for less!\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"We're introducing Pika Turbo: \"},{\"bold\":true,\"text\":\"a 3x faster, 7x cheaper\"},{\"text\":\" way to make mind-blowing, reality-bending videos.\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"bold\":true,\"text\":\"Basic users: Go try it for free on the \"},{\"bold\":true,\"href\":\"https://pika.art/app-download\",\"text\":\"Pika iOS app\",\"type\":\"link\"},{\"bold\":true,\"text\":\".\"}]}],\"date\":\"2025-01-30T17:17:16.716681+00:00\",\"created_at\":\"2025-01-30T17:17:16.716681+00:00\",\"is_published\":true,\"author\":\"7a83482c-3db8-4d40-89d7-18f014179043\",\"viewed\":false},{\"id\":2,\"title\":\"The Pika 2.0 Free-For-All is Over-For-All. \",\"description\":[{\"type\":\"paragraph\",\"children\":[{\"text\":\"We know this was a mixed bag of successes and challenges, and we want to thank everyone for their patience and forbearance as we navigated a lot more traffic than anticipated. The Pika experience is back to normal now, with a few important notes:\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"- Any video you tried to generate during the Free-For-All that didn’t finish will be completed over the next few days (for free) as we clear out the queue. They should not prevent you from generating new videos.\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"- If you’re on a paid plan, any new video requests will be put in a priority queue, and should generate within a few minutes 🏄‍♀️. These videos will cost credits again, per your plan.\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"\"}]},{\"type\":\"paragraph\",\"children\":[{\"text\":\"- Standard Plan members now have full-time access to Pika 2.0! 🥳\"}]}],\"date\":\"2024-12-23T23:38:14.240794+00:00\",\"created_at\":\"2024-12-23T23:38:14.240794+00:00\",\"is_published\":true,\"author\":\"7a83482c-3db8-4d40-89d7-18f014179043\",\"viewed\":false},{\"id\":1,\"title\":\"Exciting update about Pika updates!\",\"description\":[{\"type\":\"paragraph\",\"children\":[{\"text\":\"We've launched this changelog to keep you posted on all the latest Pika developments and updates. Keep your eyes peeled for more new features soon! 👀 \"}]}],\"date\":\"2024-10-24T17:48:54.545285+00:00\",\"created_at\":\"2024-10-24T17:48:54.545285+00:00\",\"is_published\":true,\"author\":\"7a83482c-3db8-4d40-89d7-18f014179043\",\"viewed\":false}]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"34:I[10910,[\"/_next/static/chunks/0272e043a0d8b526.js\",\"/_next/static/chunks/8176527de324d602.js\",\"/_next/static/chunks/8122493b026037b5.js\",\"/_next/static/chunks/41614b15815a9be6.js\",\"/_next/static/chunks/65e53f544b7fa638.js\",\"/_next/static/chunks/01adfdec90f46904.js\